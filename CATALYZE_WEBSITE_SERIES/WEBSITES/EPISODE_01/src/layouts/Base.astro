---
import '../styles/global.css';
import site from '../content/site.json';
const { business, hours, concept } = site;
const title = `${business.name} | Coffee, brunch and wood-fired pizza, New Brighton`;
const description = `${business.tagline} ${business.address.join(', ')}.`;
---
<!doctype html>
<html lang="en-GB" data-mode="day">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1d2433" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Pick Day or Night before first paint, from the real time in New Brighton. ?mode=day|night overrides (used for screen recordings). -->
    <script is:inline define:vars={{ tz: hours.timezone, nightStarts: hours.nightStarts }}>
      (function () {
        var d = document.documentElement; d.classList.add('js');
        var q = new URLSearchParams(location.search).get('mode');
        var mode = q === 'day' || q === 'night' ? q : null;
        if (!mode) {
          var t = new Intl.DateTimeFormat('en-GB', { timeZone: tz, hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date());
          var mins = +t.slice(0, 2) * 60 + +t.slice(3, 5);
          var n = nightStarts.split(':'); var start = +n[0] * 60 + +n[1];
          mode = mins >= start || mins < 5 * 60 ? 'night' : 'day';
        }
        d.dataset.mode = mode;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#menu">Skip to the menu</a>
    <div class="concept-strip"><span>{concept.label}</span><span class="concept-detail">{concept.detail}</span></div>
    <slot />
    <div class="mode-wipe" aria-hidden="true"></div>
    <script>
      import '../scripts/main.ts';
    </script>
    <style is:global>
      .skip { position: absolute; left: -9999px; }
      .skip:focus { left: 12px; top: 12px; z-index: 100; background: var(--paper); color: var(--ink); padding: 10px 14px; border-radius: var(--radius); }
      .concept-strip { display: flex; flex-wrap: wrap; gap: 4px 14px; justify-content: center; padding: 8px max(20px, env(safe-area-inset-left, 0px)); font: 500 12px/1.4 var(--font-mono); letter-spacing: .04em; background: var(--ink); color: var(--glass-clear); text-align: center; }
      .concept-strip span:first-child { color: var(--glass-mustard); text-transform: uppercase; letter-spacing: .12em; }
      @media (max-width: 700px) { .concept-detail { display: none; } }
    </style>
  </body>
</html>
