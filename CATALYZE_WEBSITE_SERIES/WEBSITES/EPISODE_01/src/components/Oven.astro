---
import site from '../content/site.json';
const { oven, hours } = site;
---
<section id="oven" class="oven">
  <div class="wrap grid">
    <div class="clock reveal" data-oven>
      <p class="label">The oven lights at</p>
      <p class="big">{hours.pizzaFrom}</p>
      <p class="count" data-oven-count></p>
    </div>
    <div class="reveal">
      <h2 class="h-section">{oven.headline}</h2>
      <p class="lead">{oven.body}</p>
    </div>
  </div>
</section>

<style>
  .oven { background: var(--night-bg); color: var(--night-fg); --muted: var(--night-muted); --line: var(--night-line); --accent: var(--night-accent); border-top: 0; }
  .grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(40px, 7vw, 120px); align-items: center; }
  .clock { position: relative; }
  .big { position: relative; font-family: var(--font-display); font-weight: 300; font-size: clamp(110px, 17vw, 260px); line-height: .85; letter-spacing: -0.05em; margin: 18px 0 26px; font-variant-numeric: tabular-nums; }
  .count { position: relative; margin: 0; font-family: var(--font-display); font-size: 22px; color: var(--accent); }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
</style>
