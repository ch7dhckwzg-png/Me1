---
import site from '../content/site.json';
const { oven } = site;
// Brick arch around the oven mouth, laid out as voussoirs.
const bricks = Array.from({ length: 13 }, (_, i) => {
  const a0 = Math.PI + (i / 13) * Math.PI, a1 = Math.PI + ((i + 1) / 13) * Math.PI;
  const r0 = 92, r1 = 122, g = 0.012;
  const p = (r: number, a: number) => `${(r * Math.cos(a)).toFixed(1)},${(r * Math.sin(a)).toFixed(1)}`;
  return `M${p(r0, a0 + g)} L${p(r1, a0 + g)} A${r1} ${r1} 0 0 1 ${p(r1, a1 - g)} L${p(r0, a1 - g)} A${r0} ${r0} 0 0 0 ${p(r0, a0 + g)}Z`;
});
---
<section id="oven" class="oven">
  <div class="wrap grid">
    <div class="reveal">
      <p class="kicker">{oven.kicker}</p>
      <h2 class="h-section">{oven.headline}</h2>
      <p class="lead">{oven.body}</p>
      <p class="count" data-oven-count></p>
      <button type="button" class="btn btn-solid" data-light-oven data-label={oven.button} data-label-lit={oven.buttonLit}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.6 2.4c.5 3-1.6 4.6-3 6.4-1.2 1.5-2.1 3.1-2.1 5.1a4.5 4.5 0 0 0 9 0c0-1.3-.5-2.3-1.2-3.2.1 1.3-.4 2.4-1.5 2.9.6-2.9-.3-5.2-1.2-7.2-.4-1.4-.4-2.8 0-4Z"/></svg>
        <span>{oven.button}</span>
      </button>
    </div>

    <div class="stage reveal" data-oven>
      <svg viewBox="-200 -190 400 300" role="img" aria-label="Illustration of a wood-fired pizza oven">
        <defs>
          <radialGradient id="glow" cx="0" cy="40" r="170" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#ffb347" stop-opacity=".9"/>
            <stop offset=".45" stop-color="#ff6a35" stop-opacity=".35"/>
            <stop offset="1" stop-color="#ff6a35" stop-opacity="0"/>
          </radialGradient>
          <linearGradient id="dome" x1="0" y1="-180" x2="0" y2="80" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#3a4256"/><stop offset="1" stop-color="#1b2130"/>
          </linearGradient>
          <clipPath id="mouth"><path d="M-88 70 L-88 0 A88 88 0 0 1 88 0 L88 70Z"/></clipPath>
        </defs>
        <circle class="halo" cx="0" cy="30" r="190" fill="url(#glow)"/>
        <path d="M-180 80 C-180 -80 -100 -180 0 -180 C100 -180 180 -80 180 80Z" fill="url(#dome)"/>
        {bricks.map((d, i) => <path d={d} fill={i % 2 ? '#c4572a' : '#d8673a'} />)}
        <path d="M-88 70 L-88 0 A88 88 0 0 1 88 0 L88 70Z" fill="#0d0f14"/>
        <g clip-path="url(#mouth)">
          <rect class="heat" x="-90" y="-90" width="180" height="170" fill="url(#glow)"/>
          <g class="logs"><rect x="-70" y="44" width="70" height="12" rx="6" fill="#4b2f1f" transform="rotate(-8 -35 50)"/><rect x="-30" y="46" width="78" height="12" rx="6" fill="#5a3824" transform="rotate(10 9 52)"/></g>
          <g class="embers">
            <circle cx="-40" cy="52" r="3" fill="#ff8a3d"/><circle cx="-12" cy="56" r="2.4" fill="#ffb347"/><circle cx="18" cy="50" r="3" fill="#ff6a35"/><circle cx="36" cy="57" r="2" fill="#ffb347"/>
          </g>
          <g class="flames">
            <path class="f f1" d="M-60 56 C-74 20 -44 6 -50 -24 C-30 -4 -20 18 -28 56Z" fill="#ff6a35"/>
            <path class="f f2" d="M-36 56 C-48 4 -6 -14 -14 -52 C14 -22 24 10 10 56Z" fill="#ff8a3d"/>
            <path class="f f3" d="M-4 56 C-10 18 22 4 18 -30 C40 -6 46 26 34 56Z" fill="#ffb347"/>
            <path class="f f4" d="M-20 56 C-24 30 -4 20 -6 0 C8 14 12 34 6 56Z" fill="#ffe08a"/>
          </g>
        </g>
        <rect x="-200" y="78" width="400" height="12" rx="3" fill="#2a3142"/>
      </svg>
    </div>
  </div>
</section>

<style>
  .oven { background: var(--navy); color: var(--wall); --muted: #a9b0bf; --accent: #ff6a35; --accent-ink: var(--ink); }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(32px, 6vw, 96px); align-items: center; }
  .count { font: 500 15px/1.4 var(--font-mono); color: var(--glass-mustard); margin: 0 0 22px; min-height: 1.4em; }
  .stage svg { width: 100%; height: auto; overflow: visible; }
  .halo, .heat { opacity: .15; transition: opacity 1.4s ease; }
  .flames { transform-origin: 0 56px; transform: scaleY(.15); opacity: 0; transition: transform 1.2s cubic-bezier(.2,.8,.2,1), opacity .8s; }
  .embers circle { opacity: .5; }
  .f { transform-box: fill-box; transform-origin: 50% 100%; }

  :global([data-mode="night"]) .flames, .lit .flames { transform: scaleY(1); opacity: 1; }
  :global([data-mode="night"]) .halo, .lit .halo { opacity: 1; }
  :global([data-mode="night"]) .heat, .lit .heat { opacity: .9; }

  /* flicker plays when the oven is lit (a click, or arrival at night), then settles */
  .flicker .f1 { animation: fl 0.9s ease-in-out 5 alternate; }
  .flicker .f2 { animation: fl 0.7s ease-in-out 6 alternate .1s; }
  .flicker .f3 { animation: fl 0.8s ease-in-out 6 alternate .2s; }
  .flicker .f4 { animation: fl 0.6s ease-in-out 7 alternate; }
  .flicker .embers circle { animation: em 1s ease-in-out 4 alternate; }
  @keyframes fl { 0% { transform: scale(1, 1) skewX(0); } 50% { transform: scale(.92, 1.12) skewX(-4deg); } 100% { transform: scale(1.05, .9) skewX(3deg); } }
  @keyframes em { to { opacity: 1; } }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } .stage { order: -1; max-width: 520px; } }
</style>
