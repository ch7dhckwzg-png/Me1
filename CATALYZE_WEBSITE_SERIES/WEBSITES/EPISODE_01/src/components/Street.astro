---
import site from '../content/site.json';
const { street } = site;
// Shopfront elevation, drawn in fine line. Glass panes seeded so they're stable.
let seed = 7;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const tint = () => { const r = rnd(); return r < .14 ? 'm' : r < .22 ? 't' : r < .3 ? 's' : ''; };
const row = (x0: number, w: number, cols: number) =>
  Array.from({ length: cols * 2 }, (_, i) => ({ x: x0 + (i % cols) * (w / cols), y: 40 + Math.floor(i / cols) * 20, w: w / cols, t: tint() }));
const panes = [...row(40, 300, 12), ...row(360, 120, 4), ...row(500, 300, 12)];
---
<section class="street">
  <div class="wrap grid">
    <div class="reveal">
      <p class="label label-accent">{street.kicker}</p>
      <h2 class="h-section">{street.headline}</h2>
      <p class="lead">{street.body}</p>
      <p class="dir">{street.directions}</p>
    </div>

    <figure class="front reveal">
      <svg viewBox="0 0 840 470" role="img" aria-label="Fine line drawing of the Social 114 shopfront" fill="none" stroke="currentColor" stroke-width="1">
        <g class="glass">{panes.map((p) => <rect x={p.x} y={p.y} width={p.w} height="20" class={p.t} />)}</g>
        <rect x="20" y="24" width="800" height="380" />
        <rect x="40" y="88" width="300" height="296" class="win" />
        <rect x="500" y="88" width="300" height="296" class="win" />
        <path d="M40 300 H340 M500 300 H800" class="sill" />
        <rect x="360" y="88" width="120" height="316" class="door" />
        <rect x="378" y="110" width="84" height="130" class="win" />
        <circle cx="462" cy="290" r="3.5" />
        <text x="190" y="214" text-anchor="middle" class="sign">Social 114.</text>
        <path d="M600 88 V150 M700 88 V150" />
        <circle cx="600" cy="158" r="8" class="bulb" /><circle cx="700" cy="158" r="8" class="bulb" />
        <path d="M0 404 H840" />
        <path d="M20 440 H820 M20 434 V446 M820 434 V446" class="dim" />
        <text x="420" y="462" text-anchor="middle" class="note">114 VICTORIA ROAD, NEW BRIGHTON</text>
      </svg>
    </figure>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(40px, 7vw, 120px); align-items: center; }
  .dir { margin: 28px 0 0; padding-top: 20px; border-top: 1px solid var(--line); font-size: 15px; color: var(--muted); max-width: 44ch; }
  .front { margin: 0; color: var(--fg); }
  .front svg { width: 100%; height: auto; display: block; overflow: visible; }
  .front svg :global(*) { vector-effect: non-scaling-stroke; }
  .glass rect { stroke-opacity: .7; }
  .glass .m { fill: var(--glass-mustard); fill-opacity: .75; }
  .glass .t { fill: var(--glass-teal); fill-opacity: .75; }
  .glass .s { fill: var(--glass-sky); fill-opacity: .75; }
  .door { fill: var(--accent); fill-opacity: .9; }
  .win { fill: var(--warm-window); fill-opacity: 0; transition: fill-opacity 1.2s var(--ease); }
  .bulb { fill: var(--warm-window); fill-opacity: 0; transition: fill-opacity 1.2s var(--ease); }
  .sill, .dim { stroke-opacity: .5; }
  .sign { font-family: var(--font-display); font-weight: 400; font-size: 44px; fill: currentColor; stroke: none; letter-spacing: -0.02em; }
  .note { font: 400 11px var(--font-mono); letter-spacing: .2em; fill: var(--muted); stroke: none; }
  :global([data-mode="night"]) .win { fill-opacity: .16; }
  :global([data-mode="night"]) .bulb { fill-opacity: 1; filter: drop-shadow(0 0 8px rgba(233, 184, 106, .8)); }
  @media (max-width: 960px) { .grid { grid-template-columns: 1fr; } }
</style>
