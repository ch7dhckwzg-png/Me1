---
import site from '../content/site.json';
const { menu } = site;
const tabs = [
  { id: 'brunch', ...menu.brunch },
  { id: 'pizza', ...menu.pizza },
  { id: 'drinks', ...menu.drinks },
];
---
<section id="menu" class="menu">
  <div class="wrap">
    <div class="top reveal">
      <div>
        <p class="label label-accent">The menu</p>
        <h2 class="h-section">Short, simple, <em>done properly.</em></h2>
      </div>
      <p class="lead">{menu.note}</p>
    </div>

    <div class="tabs reveal" role="tablist" aria-label="Menu">
      {tabs.map((t) => (
        <button role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected="false" data-tab={t.id} type="button">
          <span class="tl">{t.label}</span><span class="label">{t.when}</span>
        </button>
      ))}
    </div>

    <div id="panel-brunch" role="tabpanel" aria-labelledby="tab-brunch" class="panel" data-panel="brunch" hidden>
      <ol class="list">
        {menu.brunch.items.map((it, i) => (
          <li style={`--i:${i}`}><span class="no">{String(i + 1).padStart(2, '0')}</span><span class="n">{it.name}</span><span class="d">{it.desc}</span></li>
        ))}
      </ol>
    </div>

    <div id="panel-pizza" role="tabpanel" aria-labelledby="tab-pizza" class="panel pizza-panel" data-panel="pizza" hidden>
      <div class="pz-copy">
        <p class="lead">{menu.pizza.intro}</p>
        <div class="pz-list" role="radiogroup" aria-label="Choose a pizza to see it drawn">
          {menu.pizza.items.map((p, i) => (
            <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-pizza={p.id} class="pz-btn">
              <span class="no">{String(i + 1).padStart(2, '0')}</span>
              <span class="pz-txt"><span class="pz-name">{p.name}</span><span class="pz-desc">{p.desc}</span></span>
            </button>
          ))}
        </div>
      </div>
      <figure class="pz-stage">
        <svg id="pizza" viewBox="-170 -170 340 340" role="img" aria-label="Line drawing of the selected pizza"></svg>
        <figcaption class="label" data-pizza-caption></figcaption>
      </figure>
    </div>

    <div id="panel-drinks" role="tabpanel" aria-labelledby="tab-drinks" class="panel" data-panel="drinks" hidden>
      <ol class="list two">
        {menu.drinks.items.map((it, i) => (
          <li style={`--i:${i}`}><span class="no">{String(i + 1).padStart(2, '0')}</span><span class="n">{it.name}</span><span class="d">{it.desc}</span></li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 12px 48px; }
  .top .lead { margin-bottom: 30px; }
  .tabs { display: flex; gap: clamp(24px, 5vw, 72px); border-bottom: 1px solid var(--line); margin-top: 40px; }
  .tabs button { all: unset; cursor: pointer; padding: 0 0 18px; display: flex; align-items: baseline; gap: 14px; position: relative; }
  .tabs button:focus-visible { outline: 1.5px solid var(--accent); outline-offset: 4px; }
  .tl { font-family: var(--font-display); font-weight: 400; font-size: clamp(24px, 2.8vw, 36px); line-height: 1; color: var(--muted); transition: color .4s; }
  .tabs button::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 1.5px; background: var(--fg); transform: scaleX(0); transform-origin: left; transition: transform .6s var(--ease); }
  .tabs button[aria-selected="true"] .tl { color: var(--fg); }
  .tabs button[aria-selected="true"]::after { transform: scaleX(1); }

  .panel { padding-top: clamp(16px, 2vw, 24px); }
  .list { list-style: none; margin: 0; padding: 0; }
  .list.two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 64px; }
  .list li { display: grid; grid-template-columns: 48px minmax(0, 1fr) auto; gap: 16px; align-items: baseline; padding: 22px 0; border-bottom: 1px solid var(--line); animation: item .8s var(--ease) both; animation-delay: calc(var(--i) * 50ms); }
  @keyframes item { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .no { font: 400 12px/1 var(--font-mono); color: var(--muted); letter-spacing: .08em; }
  .n { font-family: var(--font-display); font-weight: 400; font-size: clamp(21px, 2vw, 27px); line-height: 1.2; letter-spacing: -0.01em; }
  .d { color: var(--muted); font-size: 15px; text-align: right; }

  .pizza-panel { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); align-items: center; padding-top: 48px; }
  .pz-list { margin-top: 28px; border-top: 1px solid var(--line); }
  .pz-btn { all: unset; cursor: pointer; display: grid; grid-template-columns: 48px 1fr; gap: 16px; align-items: baseline; width: 100%; box-sizing: border-box; padding: 22px 0; border-bottom: 1px solid var(--line); opacity: .45; transition: opacity .4s; }
  .pz-btn:hover { opacity: .8; }
  .pz-btn[aria-checked="true"] { opacity: 1; }
  .pz-btn[aria-checked="true"] .no { color: var(--accent); }
  .pz-btn:focus-visible { outline: 1.5px solid var(--accent); outline-offset: 4px; }
  .pz-txt { display: flex; flex-direction: column; gap: 4px; }
  .pz-name { font-family: var(--font-display); font-weight: 400; font-size: clamp(22px, 2.2vw, 28px); line-height: 1.15; }
  .pz-desc { font-size: 15px; color: var(--muted); }
  .pz-stage { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 16px; }
  #pizza { width: 100%; max-width: 520px; aspect-ratio: 1; overflow: visible; color: var(--fg); }

  @media (max-width: 860px) { .pizza-panel { grid-template-columns: 1fr; } .pz-stage { order: -1; } #pizza { max-width: 360px; } .list.two { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .list li { grid-template-columns: 34px 1fr; } .d { grid-column: 2; text-align: left; } .tabs button { flex-direction: column; gap: 6px; } }
</style>
