---
import site from '../content/site.json';
const { business, nav, modes } = site;
---
<header class="hdr">
  <div class="wrap hdr-in">
    <a href="#top" class="mark" aria-label={`${business.name}, back to top`}>{business.wordmark}</a>
    <nav aria-label="Sections">
      <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    </nav>
    <div class="switch" role="group" aria-label="Day or night">
      <button type="button" data-set-mode="day" aria-pressed="false">{modes.day.label}</button>
      <span class="track" aria-hidden="true"><i></i></span>
      <button type="button" data-set-mode="night" aria-pressed="false">{modes.night.label}</button>
    </div>
  </div>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: blur(14px) saturate(1.2); -webkit-backdrop-filter: blur(14px) saturate(1.2); border-bottom: 1px solid var(--line); padding-top: env(safe-area-inset-top, 0px); }
  .hdr-in { display: flex; align-items: center; gap: 32px; height: 72px; }
  .mark { font-family: var(--font-display); font-weight: 500; font-size: 24px; letter-spacing: -0.02em; text-decoration: none; white-space: nowrap; }
  nav { margin-left: auto; }
  nav ul { display: flex; gap: 34px; list-style: none; margin: 0; padding: 0; }
  nav a { text-decoration: none; font-size: 14px; letter-spacing: .02em; color: var(--muted); transition: color .25s; }
  nav a:hover { color: var(--fg); }
  .switch { display: flex; align-items: center; gap: 10px; }
  .switch button { border: 0; background: none; padding: 6px 0; font: 400 12px/1 var(--font-mono); letter-spacing: .16em; text-transform: uppercase; color: var(--muted); cursor: pointer; transition: color .3s; }
  .switch button[aria-pressed="true"] { color: var(--fg); }
  .track { position: relative; width: 38px; height: 20px; border: 1px solid var(--line); border-radius: 10px; }
  .track i { position: absolute; top: 3px; left: 3px; width: 12px; height: 12px; border-radius: 50%; background: var(--accent); transition: transform .6s var(--ease); }
  :global([data-mode="night"]) .track i { transform: translateX(18px); }
  @media (max-width: 860px) { nav { display: none; } .switch { margin-left: auto; } }
</style>
