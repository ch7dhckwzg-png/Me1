---
import site from '../content/site.json';
const { business, modes, hours, heroImages } = site;
const glass = ['c', 'm', 'c', 's', 'c', 't', 'c', 'm', 'c'];
const slides = [
  { mode: 'day', no: '01', kicker: modes.day.kicker, time: '9:30 to 15:00', title: ['Coffee', 'and brunch.'], body: modes.day.body },
  { mode: 'night', no: '02', kicker: modes.night.kicker, time: 'From 18:00', title: ['Wood-fired', 'pizza.'], body: modes.night.body },
];
---
<section class="hero-track" id="top" data-hero-track>
  <div class="hero" data-hero>
    <div class="dish-stage" data-dish-stage aria-hidden="true">
      <div class="dish-shadow"></div>
      <div class="rotor" data-rotor>
        <img class="dish cup" data-dish="cup" src={heroImages.cup.src} alt="" width="1100" height="1100" decoding="async" fetchpriority="high" />
        <img class="dish pizza" data-dish="pizza" src={heroImages.pizza.src} alt="" width="1100" height="1100" decoding="async" />
      </div>
    </div>

    <div class="wrap inner">
      <div class="meta">
        <span class="label">{business.address[0]}, {business.address[1]}</span>
        <span class="glass" aria-hidden="true">{glass.map((g) => <i class={g}></i>)}</span>
        <span class="label live"><span class="data" data-clock>--:--</span> in New Brighton</span>
      </div>

      <div class="copies">
        <h1 class="sr">{business.name}: coffee and brunch by day, wood-fired pizza by night</h1>
        {slides.map((s) => (
          <div class={`copy s-${s.mode}`} aria-hidden={s.mode === 'night' ? 'true' : 'false'} data-copy={s.mode}>
            <p class="label kick"><span class="label-accent">{s.no}</span><span class="bar"></span>{s.kicker}<span class="t data">{s.time}</span></p>
            <p class="title" aria-hidden="true">{s.title.map((l, i) => <span class="line"><span style={`--d:${i * 90}ms`}>{l}</span></span>)}</p>
            <p class="lead body">{s.body}</p>
            <div class="ctas">
              <a class="btn btn-solid" href="#menu">See the menu
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              <a class="btn" href="#visit">Find us</a>
            </div>
          </div>
        ))}
      </div>

      <div class="foot">
        <div class="day-line" data-today>
          <div class="rail"><i class="seg" data-seg="brunch"></i><i class="seg pz" data-seg="pizza"></i><b class="now" data-now></b></div>
          <div class="ticks" data-ticks></div>
          <p class="status" data-status>Checking the time in New Brighton</p>
        </div>
        <p class="hint label" data-hint><span>Scroll for the evening</span><i></i></p>
      </div>
    </div>
  </div>
</section>

<script is:inline type="application/json" id="hours-data" set:html={JSON.stringify(hours)}></script>

<style>
  /* the track gives the hero room to hold while the dish crosses; nothing is pinned beyond it */
  .hero-track { position: relative; height: calc(100svh + 90vh); border-top: 0; padding: 0; }
  .hero { position: sticky; top: 72px; height: calc(100svh - 72px); min-height: 620px; overflow: hidden; display: flex; }
  .inner { position: relative; z-index: 2; display: flex; flex-direction: column; width: 100%; padding-block: clamp(18px, 2.4vw, 32px) clamp(18px, 2.4vw, 28px); }
  .meta { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .glass { display: flex; gap: 3px; }
  .glass i { width: 9px; height: 9px; border: 1px solid var(--line); }
  .glass .m { background: var(--glass-mustard); border-color: transparent; }
  .glass .t { background: var(--glass-teal); border-color: transparent; }
  .glass .s { background: var(--glass-sky); border-color: transparent; }
  .live [data-clock] { color: var(--fg); font-variant-numeric: tabular-nums; }

  /* the dish: positioned by the script from scroll progress (left half to right half) */
  .dish-stage { position: absolute; z-index: 1; left: 0; top: 46%; width: min(44vw, 640px, 70svh); aspect-ratio: 1; margin-top: calc(min(44vw, 640px, 70svh) / -2); pointer-events: none; will-change: transform; }
  /* the shadow sits on the table and never turns; only the rotor spins */
  .dish-shadow { position: absolute; inset: 12% 10% 4% 12%; border-radius: 50%; background: rgba(40, 28, 16, .30); filter: blur(28px); transform: translateY(6%); transition: background-color 1.3s var(--ease); }
  :global([data-mode="night"]) .dish-shadow { background: rgba(0, 0, 0, .62); }
  .rotor { position: absolute; inset: 0; }
  .dish { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .dish.pizza { opacity: 0; }
  :global(.intro) .dish-stage .dish.cup { opacity: 0; transform: rotate(-50deg) scale(.88); filter: blur(10px); }
  .dish.cup { transition: opacity 1.2s var(--ease), transform 1.4s cubic-bezier(.2,.8,.2,1), filter 1.2s var(--ease); }

  /* copy: morning on the right (cup on the left), evening on the left (pizza on the right) */
  .copies { flex: 1; display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 48px; }
  .copy { grid-row: 1; max-width: 560px; }
  .s-day { grid-column: 2; justify-self: end; }
  .s-night { grid-column: 1; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .bar { display: inline-block; width: 28px; height: 1px; background: currentColor; vertical-align: middle; margin: 0 10px; opacity: .5; }
  .t { margin-left: 10px; color: var(--muted); }
  .title { font-family: var(--font-display); font-weight: 400; white-space: nowrap; font-size: clamp(48px, 6.6vw, 112px); line-height: .92; letter-spacing: -0.04em; margin: 20px 0 24px; display: flex; flex-direction: column; }
  .line { display: block; overflow: hidden; padding-bottom: .08em; }
  .line > span { display: block; transition: transform 1.1s cubic-bezier(.7,0,.2,1); transition-delay: var(--d); }
  .kick { color: var(--accent); }
  .kick, .body, .ctas { transition: opacity .7s var(--ease), transform .8s var(--ease); }
  .lead { max-width: 42ch; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }

  .s-night .line > span { transform: translateY(105%); }
  .s-night :is(.kick, .body, .ctas) { opacity: 0; transform: translateY(12px); pointer-events: none; }
  :global([data-mode="night"]) .s-day .line > span { transform: translateY(-105%); }
  :global([data-mode="night"]) .s-day :is(.kick, .body, .ctas) { opacity: 0; transform: translateY(-12px); pointer-events: none; }
  :global([data-mode="night"]) .s-night .line > span { transform: none; transition-delay: calc(350ms + var(--d)); }
  :global([data-mode="night"]) .s-night :is(.kick, .body, .ctas) { opacity: 1; transform: none; pointer-events: auto; transition-delay: .45s; }
  :global(.intro) .s-day .line > span { transform: translateY(105%); }
  :global(.intro) .s-day :is(.kick, .body, .ctas) { opacity: 0; }

  .foot { display: flex; align-items: end; justify-content: space-between; gap: 32px; }
  .day-line { width: min(560px, 100%); }
  .rail { position: relative; height: 1px; background: var(--line); }
  .seg { position: absolute; top: -1px; height: 3px; background: var(--fg); opacity: .5; }
  .seg.pz { background: var(--accent); opacity: 1; }
  .now { position: absolute; top: -5px; width: 11px; height: 11px; margin-left: -5px; border-radius: 50%; background: var(--bg); border: 1.5px solid var(--fg); transition: left 1s var(--ease); }
  .ticks { position: relative; height: 26px; font: 400 12px/26px var(--font-mono); color: var(--muted); letter-spacing: .06em; }
  .ticks :global(span) { position: absolute; transform: translateX(-50%); }
  .ticks :global(span:first-child) { transform: none; }
  .ticks :global(span:last-child) { transform: translateX(-100%); }
  .status { margin: 4px 0 0; font-family: var(--font-display); font-size: 18px; }
  .status :global(b) { font-weight: 400; color: var(--accent); }
  .hint { display: flex; align-items: center; gap: 12px; margin: 0; transition: opacity .6s; }
  .hint i { width: 1px; height: 36px; background: linear-gradient(var(--fg), transparent); }
  :global([data-mode="night"]) .hint { opacity: 0; }

  @media (max-width: 900px) {
    .hero-track { height: calc(100svh + 60vh); }
    .hero { min-height: 0; }
    .dish-stage { top: 96px; width: 64vw; margin-top: 0; }
    .copies { grid-template-columns: 1fr; align-items: end; padding-bottom: 8px; }
    .copy, .s-day, .s-night { grid-column: 1; justify-self: start; }
    .glass, .hint { display: none; }
    .title { font-size: clamp(44px, 12vw, 72px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-track { height: auto; }
    .hero { position: relative; top: 0; height: auto; min-height: 640px; }
  }
</style>
