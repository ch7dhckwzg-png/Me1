---
import site from '../content/site.json';
const { business, modes, hours } = site;
// A small nod to the leaded glass above their shopfront.
const glass = ['c', 'm', 'c', 's', 'c', 't', 'c', 'm', 'c'];
---
<section class="hero" id="top">
  <div class="wrap">
    <div class="meta">
      <span class="label">{business.address[0]}, {business.address[1]}</span>
      <span class="glass" aria-hidden="true">{glass.map((g) => <i class={g}></i>)}</span>
      <span class="label live"><span data-clock>--:--</span> in New Brighton</span>
    </div>

    <h1 class="word" aria-label={business.wordmark}>
      {business.wordmark.split('').map((c, i) => <span style={`--i:${i}`} aria-hidden="true">{c === ' ' ? ' ' : c}</span>)}
    </h1>

    <div class="split" role="group" aria-label="Day or night">
      <button type="button" class="side" data-set-mode="day" aria-pressed="false">
        <span class="label">{modes.day.kicker} <span class="t">9:30 to 15:00</span></span>
        <span class="side-h">{modes.day.headline}</span>
        <span class="side-b">{modes.day.body}</span>
      </button>
      <button type="button" class="side" data-set-mode="night" aria-pressed="false">
        <span class="label">{modes.night.kicker} <span class="t">From 18:00</span></span>
        <span class="side-h">{modes.night.headline}</span>
        <span class="side-b">{modes.night.body}</span>
      </button>
    </div>

    <div class="day-line" aria-label="Today's hours" data-today>
      <div class="rail"><i class="seg" data-seg="brunch"></i><i class="seg pz" data-seg="pizza"></i><b class="now" data-now></b></div>
      <div class="ticks" data-ticks></div>
      <p class="status" data-status>Checking the time in New Brighton</p>
    </div>

    <div class="ctas">
      <a class="btn btn-solid" href="#menu">See the menu
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a class="btn" href="#visit">Find us</a>
    </div>
  </div>
</section>

<script is:inline type="application/json" id="hours-data" set:html={JSON.stringify(hours)}></script>

<style>
  .hero { border-top: 0; padding-block: clamp(28px, 4vw, 48px) clamp(72px, 9vw, 128px); }
  .meta { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .glass { display: flex; gap: 3px; }
  .glass i { width: 9px; height: 9px; border: 1px solid var(--line); }
  .glass .m { background: var(--glass-mustard); border-color: transparent; }
  .glass .t { background: var(--glass-teal); border-color: transparent; }
  .glass .s { background: var(--glass-sky); border-color: transparent; }
  .live [data-clock] { color: var(--fg); font-variant-numeric: tabular-nums; }

  .word { font-family: var(--font-display); font-weight: 420; font-size: clamp(48px, 16vw, 248px); line-height: .9; letter-spacing: -0.045em; margin: clamp(40px, 6vw, 88px) 0 clamp(40px, 5vw, 72px); white-space: nowrap; display: flex; }
  .word span { display: inline-block; }
  .word span:last-child { color: var(--accent); }
  :global(.js) .word span { animation: up 1.2s var(--ease) both; animation-delay: calc(150ms + var(--i) * 40ms); }
  @keyframes up { from { opacity: 0; transform: translateY(.25em); filter: blur(6px); } to { opacity: 1; transform: none; filter: none; } }

  .split { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); }
  .side { all: unset; cursor: pointer; display: flex; flex-direction: column; gap: 14px; padding: 28px 40px 32px 0; transition: opacity .6s var(--ease); opacity: .38; }
  .side + .side { padding-left: 40px; border-left: 1px solid var(--line); }
  .side:hover { opacity: .7; }
  .side[aria-pressed="true"] { opacity: 1; }
  .side[aria-pressed="true"] .label { color: var(--accent); }
  .side:focus-visible { outline: 1.5px solid var(--accent); outline-offset: 4px; }
  .t { margin-left: 10px; color: var(--muted); }
  .side-h { font-family: var(--font-display); font-weight: 400; font-size: clamp(26px, 2.6vw, 38px); line-height: 1.1; letter-spacing: -0.015em; text-wrap: balance; }
  .side-b { color: var(--muted); max-width: 46ch; }

  .day-line { margin-top: 18px; }
  .rail { position: relative; height: 1px; background: var(--line); margin-top: 26px; }
  .seg { position: absolute; top: -1px; height: 3px; background: var(--fg); opacity: .55; }
  .seg.pz { background: var(--accent); opacity: 1; }
  .now { position: absolute; top: -5px; width: 11px; height: 11px; margin-left: -5px; border-radius: 50%; background: var(--bg); border: 1.5px solid var(--fg); transition: left 1s var(--ease); }
  .ticks { position: relative; height: 26px; font: 400 11px/26px var(--font-mono); color: var(--muted); letter-spacing: .06em; }
  .ticks :global(span) { position: absolute; transform: translateX(-50%); }
  .ticks :global(span:first-child) { transform: none; }
  .ticks :global(span:last-child) { transform: translateX(-100%); }
  .status { margin: 10px 0 0; font-family: var(--font-display); font-size: 20px; }
  .status :global(b) { font-weight: 400; font-style: italic; color: var(--accent); }

  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  @media (max-width: 760px) {
    .split { grid-template-columns: 1fr; }
    .side, .side + .side { padding: 24px 0; border-left: 0; }
    .side + .side { border-top: 1px solid var(--line); }
    .glass { display: none; }
  }
</style>
