---
import site from '../content/site.json';
const { business, modes, hours } = site;
const glass = ['c', 'm', 'c', 's', 'c', 't', 'c', 'm', 'c'];
const slides = [
  { mode: 'day', no: '01', kicker: modes.day.kicker, time: '9:30 to 15:00', title: ['Coffee', 'and brunch.'], body: modes.day.body },
  { mode: 'night', no: '02', kicker: modes.night.kicker, time: 'From 18:00', title: ['Wood-fired', 'pizza.'], body: modes.night.body },
];
---
<section class="hero" id="top">
  <div class="dish-stage" aria-hidden="true">
    <div class="halo"></div>
    <canvas class="dish cup" data-dish="cup"></canvas>
    <canvas class="dish pizza" data-dish="pizza"></canvas>
  </div>

  <div class="wrap inner">
    <div class="meta">
      <span class="label">{business.address[0]}, {business.address[1]}</span>
      <span class="glass" aria-hidden="true">{glass.map((g) => <i class={g}></i>)}</span>
      <span class="label live"><span data-clock>--:--</span> in New Brighton</span>
    </div>

    <div class="copy">
      <div class="swap kick">
        {slides.map((s) => <p class={`label slide s-${s.mode}`}><span class="label-accent">{s.no}</span> <span class="bar"></span> {s.kicker} <span class="t">{s.time}</span></p>)}
      </div>
      <h1 class="swap title">
        <span class="sr">{business.name}: coffee and brunch by day, wood-fired pizza by night</span>
        {slides.map((s) => (
          <span class={`slide s-${s.mode}`} aria-hidden="true">
            {s.title.map((l, i) => <span class="line"><span style={`--d:${i * 90}ms`}>{l}</span></span>)}
          </span>
        ))}
      </h1>
      <div class="swap body">
        {slides.map((s) => <p class={`lead slide s-${s.mode}`}>{s.body}</p>)}
      </div>
      <div class="ctas">
        <a class="btn btn-solid" href="#menu">See the menu
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a class="btn" href="#visit">Find us</a>
      </div>
      <div class="pager" role="group" aria-label="Day or night">
        {slides.map((s) => (
          <button type="button" data-set-mode={s.mode} aria-pressed="false">
            <span class="pg-no">{s.no}</span><span class="pg-name">{s.mode === 'day' ? 'Coffee' : 'Pizza'}</span><span class="pg-bar"><i></i></span>
          </button>
        ))}
      </div>
    </div>

    <div class="day-line" data-today>
      <div class="rail"><i class="seg" data-seg="brunch"></i><i class="seg pz" data-seg="pizza"></i><b class="now" data-now></b></div>
      <div class="ticks" data-ticks></div>
      <p class="status" data-status>Checking the time in New Brighton</p>
    </div>
  </div>
</section>

<script is:inline type="application/json" id="hours-data" set:html={JSON.stringify(hours)}></script>

<style>
  .hero { position: relative; overflow: hidden; border-top: 0; padding-block: clamp(24px, 3vw, 40px) clamp(40px, 5vw, 64px); min-height: min(940px, calc(100svh - 104px)); display: flex; }
  .inner { position: relative; z-index: 2; display: flex; flex-direction: column; width: 100%; }
  .meta { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .glass { display: flex; gap: 3px; }
  .glass i { width: 9px; height: 9px; border: 1px solid var(--line); }
  .glass .m { background: var(--glass-mustard); border-color: transparent; }
  .glass .t { background: var(--glass-teal); border-color: transparent; }
  .glass .s { background: var(--glass-sky); border-color: transparent; }
  .live [data-clock] { color: var(--fg); font-variant-numeric: tabular-nums; }

  /* the dish sits behind the copy on the right, like a plate on the table */
  .dish-stage { position: absolute; z-index: 1; top: 50%; right: max(-3vw, -48px); width: min(52vw, 740px); aspect-ratio: 1; transform: translateY(-50%); pointer-events: none; }
  .halo { position: absolute; inset: 8%; border-radius: 50%; background: radial-gradient(closest-side, rgba(215,105,60,.22), rgba(215,105,60,0)); opacity: 0; transition: opacity 1.6s var(--ease); }
  :global([data-mode="night"]) .halo { opacity: 1; }
  .dish { position: absolute; inset: 0; width: 100%; height: 100%; transition: transform 1.5s cubic-bezier(.65,0,.2,1), opacity 1.1s var(--ease), filter 1.3s var(--ease); will-change: transform, opacity, filter; }
  /* resting, leaving and arriving states (rotation reads as the plate being turned) */
  .dish.cup { transform: rotate(0) scale(1); }
  .dish.pizza { transform: rotate(-80deg) scale(.82); opacity: 0; filter: blur(14px); }
  :global([data-mode="night"]) .dish.cup { transform: rotate(95deg) scale(1.12); opacity: 0; filter: blur(16px); }
  :global([data-mode="night"]) .dish.pizza { transform: rotate(0) scale(1); opacity: 1; filter: none; }
  :global(.intro) .dish.cup { transform: rotate(-60deg) scale(.86); opacity: 0; filter: blur(14px); }

  .copy { margin-block: auto; padding-block: clamp(40px, 6vw, 80px); max-width: 620px; }
  .swap { display: grid; }
  .swap > .slide { grid-area: 1 / 1; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .bar { display: inline-block; width: 28px; height: 1px; background: currentColor; vertical-align: middle; margin: 0 8px; opacity: .5; }
  .t { margin-left: 10px; color: var(--muted); }
  .title { font-family: var(--font-display); font-weight: 400; white-space: nowrap; font-size: clamp(50px, 7.4vw, 120px); line-height: .92; letter-spacing: -0.04em; margin: 22px 0 26px; }
  .title .slide { display: flex; flex-direction: column; }
  .line { display: block; overflow: hidden; padding-bottom: .08em; }
  .line > span { display: block; transition: transform 1.1s cubic-bezier(.7,0,.2,1), opacity .8s; transition-delay: var(--d); }
  .line:last-child > span { font-style: italic; }
  .lead.slide, .kick .slide { transition: opacity .8s var(--ease), transform .9s var(--ease); }
  .lead { max-width: 44ch; }

  /* day slide visible by default; night slide waits below */
  .s-night .line > span { transform: translateY(105%); }
  .kick .s-night, .body .s-night { opacity: 0; transform: translateY(12px); }
  :global([data-mode="night"]) .s-day .line > span { transform: translateY(-105%); }
  :global([data-mode="night"]) .s-night .line > span { transform: none; transition-delay: calc(450ms + var(--d)); }
  :global([data-mode="night"]) .kick .s-day, :global([data-mode="night"]) .body .s-day { opacity: 0; transform: translateY(-12px); }
  :global([data-mode="night"]) .kick .s-night, :global([data-mode="night"]) .body .s-night { opacity: 1; transform: none; transition-delay: .55s; }
  :global(.intro) .s-day .line > span { transform: translateY(105%); }
  :global(.intro) .kick .s-day, :global(.intro) .body .s-day { opacity: 0; }

  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
  .pager { display: flex; gap: 28px; margin-top: 44px; }
  .pager button { all: unset; cursor: pointer; display: grid; grid-template-columns: auto 1fr; gap: 6px 10px; align-items: baseline; min-width: 132px; }
  .pager button:focus-visible { outline: 1.5px solid var(--accent); outline-offset: 6px; }
  .pg-no { font: 400 11px/1 var(--font-mono); color: var(--muted); letter-spacing: .1em; }
  .pg-name { font-family: var(--font-display); font-size: 18px; color: var(--muted); transition: color .5s; }
  .pg-bar { grid-column: 1 / -1; height: 1px; background: var(--line); position: relative; overflow: hidden; }
  .pg-bar i { position: absolute; inset: 0; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform 1.4s var(--ease); }
  .pager [aria-pressed="true"] .pg-name { color: var(--fg); }
  .pager [aria-pressed="true"] .pg-bar i { transform: scaleX(1); }

  .day-line { max-width: 620px; }
  .rail { position: relative; height: 1px; background: var(--line); }
  .seg { position: absolute; top: -1px; height: 3px; background: var(--fg); opacity: .5; }
  .seg.pz { background: var(--accent); opacity: 1; }
  .now { position: absolute; top: -5px; width: 11px; height: 11px; margin-left: -5px; border-radius: 50%; background: var(--bg); border: 1.5px solid var(--fg); transition: left 1s var(--ease); }
  .ticks { position: relative; height: 26px; font: 400 11px/26px var(--font-mono); color: var(--muted); letter-spacing: .06em; }
  .ticks :global(span) { position: absolute; transform: translateX(-50%); }
  .ticks :global(span:first-child) { transform: none; }
  .ticks :global(span:last-child) { transform: translateX(-100%); }
  .status { margin: 6px 0 0; font-family: var(--font-display); font-size: 19px; }
  .status :global(b) { font-weight: 400; font-style: italic; color: var(--accent); }

  @media (max-width: 900px) {
    .hero { min-height: 0; }
    .dish-stage { top: 76px; right: -18vw; width: 74vw; transform: none; }
    .copy { padding-top: 66vw; }
    .glass { display: none; }
  }
</style>
