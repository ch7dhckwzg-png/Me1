---
import site from '../content/site.json';
const { visit, business, hours, concept } = site;
const fmt = (t: string) => (t === 'late' ? 'Late' : t);
---
<section id="visit" class="visit">
  <div class="wrap grid">
    <div class="reveal">
      <p class="label label-accent">{visit.kicker}</p>
      <h2 class="h-section">{visit.headline}</h2>
      <address>{business.address.map((l) => <span>{l}</span>)}</address>
      <div class="ctas">
        <a class="btn btn-solid" href={business.mapsUrl} target="_blank" rel="noopener">{visit.mapsLabel}
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6 14 14 6M8 6h6v6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a class="btn" href={business.instagram.url} target="_blank" rel="noopener">Instagram</a>
        <a class="btn" href={business.facebook.url} target="_blank" rel="noopener">Facebook</a>
      </div>
      <p class="dogs">{visit.dogs}</p>
    </div>

    <div class="reveal">
      <table>
        <caption class="label">Opening hours</caption>
        <tbody>
          {hours.week.map((d) => (
            <tr data-day={d.day}>
              <th scope="row">{d.day}<span class="tag">Today</span></th>
              <td>{d.closed ? 'Closed' : `${fmt(d.open!)} to ${fmt(d.close!)}`}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="fine">Brunch {hours.brunch.from} to {hours.brunch.to}. Pizza from {hours.pizzaFrom}. Hours from public listings, to be confirmed.</p>
    </div>
  </div>
</section>

<footer class="foot">
  <div class="wrap foot-in">
    <span class="fmark">{business.wordmark}</span>
    <p><b>{concept.label}.</b> {concept.detail} Website concept and build by CATALYZE, {concept.catalyze}.</p>
  </div>
</footer>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(40px, 7vw, 120px); align-items: start; }
  address { font-style: normal; display: flex; flex-direction: column; font-size: 19px; line-height: 1.55; color: var(--muted); }
  .ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 32px; }
  .dogs { margin: 28px 0 0; font-size: 15px; color: var(--muted); }
  table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  caption { text-align: left; padding-bottom: 14px; }
  th, td { text-align: left; padding: 17px 0; border-top: 1px solid var(--line); font-size: 17px; font-weight: 400; }
  tr:last-child th, tr:last-child td { border-bottom: 1px solid var(--line); }
  td { text-align: right; color: var(--muted); font-family: var(--font-mono); font-size: 14px; letter-spacing: .04em; }
  .tag { display: none; margin-left: 12px; font: 400 10px/1 var(--font-mono); letter-spacing: .16em; text-transform: uppercase; color: var(--accent); vertical-align: 2px; }
  tr:global(.today) th, tr:global(.today) td { color: var(--fg); }
  tr:global(.today) .tag { display: inline; }
  .fine { font-size: 13px; color: var(--muted); margin: 16px 0 0; }
  .foot { background: #0b0e15; color: #e6dfd2; padding-block: 48px calc(48px + env(safe-area-inset-bottom, 0px)); }
  .foot-in { display: flex; flex-wrap: wrap; gap: 16px 48px; align-items: baseline; justify-content: space-between; }
  .fmark { font-family: var(--font-display); font-weight: 420; font-size: 32px; letter-spacing: -0.02em; }
  .foot p { max-width: 68ch; margin: 0; font-size: 13px; color: #9a9fab; }
  .foot b { color: #e6dfd2; font-weight: 500; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
</style>
