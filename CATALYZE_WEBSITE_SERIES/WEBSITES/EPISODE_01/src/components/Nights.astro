---
import site from '../content/site.json';
const { nights, business } = site;
const grooves = Array.from({ length: 16 }, (_, i) => 62 + i * 5.2);
---
<section id="nights" class="nights">
  <div class="wrap grid">
    <div class="deck reveal">
      <div class="record" data-record>
        <svg viewBox="-150 -150 300 300" aria-hidden="true">
          <circle r="148" fill="#121318"/>
          {grooves.map((r) => <circle r={r} fill="none" stroke="#24262e" stroke-width="1.1"/>)}
          <path d="M-120 -60 A135 135 0 0 1 -40 -128" stroke="rgba(255,255,255,.12)" stroke-width="10" fill="none" stroke-linecap="round"/>
          <circle r="52" fill="var(--door)"/>
          <text y="-8" text-anchor="middle" font-family="Fraunces Variable, Georgia, serif" font-weight="800" font-size="19" fill="#fff">Social 114.</text>
          <text y="14" text-anchor="middle" font-family="DM Mono, monospace" font-size="8.5" letter-spacing="1.5" fill="#fff">SIDE A / NIGHTS</text>
          <circle r="4" fill="#121318"/>
        </svg>
      </div>
      <button type="button" class="play" data-play data-label-play={nights.play} data-label-pause={nights.pause} aria-label={nights.play} aria-pressed="false">
        <svg class="ico-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5Z" fill="currentColor"/></svg>
        <svg class="ico-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.6v14H7zM13.4 5H17v14h-3.6z" fill="currentColor"/></svg>
      </button>
      <div class="arm" aria-hidden="true"><i></i></div>
    </div>

    <div class="reveal">
      <p class="kicker">{nights.kicker}</p>
      <h2 class="h-section">{nights.headline}</h2>
      <p class="lead">{nights.body}</p>
      <ul class="events">
        {nights.events.items.map((e) => (
          <li><span class="when">{e.when}</span><span class="what">{e.what}</span><span class="detail">{e.detail}</span></li>
        ))}
      </ul>
      <a class="btn" href={business.instagram.url} target="_blank" rel="noopener">Dates on Instagram {business.instagram.handle}</a>
    </div>
  </div>
</section>

<style>
  .nights { background: var(--bg); transition: background-color var(--t); }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); align-items: center; }
  .deck { position: relative; overflow: hidden; aspect-ratio: 1; max-width: 520px; width: 100%; background: var(--birch); border-radius: var(--radius-card); padding: 9%; box-shadow: inset 0 0 0 1px rgba(0,0,0,.08); }
  .record { width: 100%; height: 100%; border-radius: 50%; box-shadow: 0 24px 50px -18px rgba(0,0,0,.55); }
  .record svg { width: 100%; height: 100%; display: block; }
  .record.spin svg { animation: spin 1.8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .play { position: absolute; right: 5%; bottom: 5%; width: 64px; height: 64px; border-radius: 50%; border: 0; background: var(--ink); color: var(--wall); display: grid; place-items: center; cursor: pointer; transition: transform .2s, background-color .25s; }
  .play:hover { transform: scale(1.06); }
  .play svg { width: 26px; height: 26px; grid-area: 1 / 1; }
  .play .ico-pause { opacity: 0; }
  .play[aria-pressed="true"] { background: var(--door); }
  .play[aria-pressed="true"] .ico-play { opacity: 0; }
  .play[aria-pressed="true"] .ico-pause { opacity: 1; }
  .arm { position: absolute; top: 6%; right: 8%; width: 30%; height: 50%; transform-origin: 85% 8%; transform: rotate(-28deg); transition: transform .9s cubic-bezier(.3,.8,.2,1); pointer-events: none; }
  .arm i { position: absolute; right: 12%; top: 4%; width: 5px; height: 92%; background: #cfd3da; border-radius: 3px; transform: rotate(14deg); transform-origin: top; }
  .arm i::before { content: ""; position: absolute; top: -10px; left: -9px; width: 23px; height: 23px; border-radius: 50%; background: #9aa1ad; }
  .arm i::after { content: ""; position: absolute; bottom: -6px; left: -5px; width: 15px; height: 20px; border-radius: 3px; background: #2b2f38; }
  .playing .arm { transform: rotate(0deg); }
  .events { list-style: none; margin: 8px 0 28px; padding: 0; border-top: 1px solid var(--line); }
  .events li { display: grid; grid-template-columns: 110px 1fr auto; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--line); align-items: baseline; }
  .when { font: 500 13px/1 var(--font-mono); color: var(--accent); text-transform: uppercase; letter-spacing: .08em; }
  .what { font-family: var(--font-display); font-weight: 600; font-size: 22px; }
  .detail { font-size: 14px; color: var(--muted); }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } .deck { max-width: 420px; } }
  @media (max-width: 480px) { .events li { grid-template-columns: 1fr; gap: 4px; } }
</style>
