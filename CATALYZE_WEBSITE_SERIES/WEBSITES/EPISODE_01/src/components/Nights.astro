---
import site from '../content/site.json';
const { nights, business } = site;
---
<section id="nights" class="nights">
  <div class="wrap grid">
    <div class="reveal">
      <p class="label label-accent">{nights.kicker}</p>
      <h2 class="h-section">{nights.headline}</h2>
      <p class="lead">{nights.body}</p>
    </div>
    <div class="reveal">
      <ul class="events">
        {nights.events.items.map((e) => (
          <li><span class="label">{e.when}</span><span class="what">{e.what}</span><span class="detail">{e.detail}</span></li>
        ))}
      </ul>
      <a class="btn" href={business.instagram.url} target="_blank" rel="noopener">Dates on Instagram, {business.instagram.handle}</a>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(40px, 7vw, 120px); align-items: end; }
  .events { list-style: none; margin: 0 0 32px; padding: 0; border-top: 1px solid var(--line); }
  .events li { display: grid; grid-template-columns: 120px 1fr auto; gap: 16px; padding: 24px 0; border-bottom: 1px solid var(--line); align-items: baseline; }
  .what { font-family: var(--font-display); font-size: 26px; letter-spacing: -0.01em; }
  .detail { font-size: 14px; color: var(--muted); }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .events li { grid-template-columns: 1fr; gap: 6px; } }
</style>
