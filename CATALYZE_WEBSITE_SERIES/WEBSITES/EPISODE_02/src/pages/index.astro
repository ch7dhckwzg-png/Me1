---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Mirror from '../components/Mirror.astro';
import Intro from '../components/Intro.astro';
import Finder from '../components/Finder.astro';
import Prices from '../components/Prices.astro';
import Consult from '../components/Consult.astro';
import Room from '../components/Room.astro';
import Street from '../components/Street.astro';
import Visit from '../components/Visit.astro';
import Booking from '../components/Booking.astro';
---
<Base>
  <Header />
  <main id="top">
    <Mirror />
    <Intro />
    <Finder />
    <Prices />
    <Consult />
    <Room />
    <Street />
    <Visit />
  </main>
  <Booking />
</Base>
