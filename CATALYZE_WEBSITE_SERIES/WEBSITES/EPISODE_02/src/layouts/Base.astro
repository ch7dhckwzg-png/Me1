---
import '../styles/global.css';
import site from '../content/site.json';
const { business, concept } = site;
const title = `${business.name} | Gym in Birkenhead and Ellesmere Port`;
---
<!doctype html>
<html lang="en-GB" data-site="birkenhead">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={business.tagline} />
    <meta name="theme-color" content="#141517" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Opens on Birkenhead. ?site=ellesmere holds the other gym (for recordings). -->
    <script is:inline>
      (function () {
        var d = document.documentElement; d.classList.add('js');
        var q = new URLSearchParams(location.search).get('site');
        if (q === 'ellesmere') d.dataset.site = 'ellesmere';
        else if (!matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('intro');
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#timetable">Skip to the timetable</a>
    <div class="concept-strip"><span>{concept.label}</span><span class="concept-detail">{concept.detail}</span></div>
    <slot />
    <script>
      import '../scripts/main.ts';
    </script>
    <style is:global>
      .skip { position: absolute; left: -9999px; }
      .skip:focus { left: 12px; top: 12px; z-index: 100; background: var(--bg); color: var(--fg); padding: 10px 14px; border-radius: var(--radius); }
      .concept-strip { display: flex; flex-wrap: wrap; gap: 4px 16px; justify-content: center; padding: 9px var(--gutter-r) 9px var(--gutter-l); font: 400 12px/1.45 var(--font-body); background: #0b0c0d; color: #9a9ca1; text-align: center; }
      .concept-strip span:first-child { color: #efede8; text-transform: uppercase; letter-spacing: .14em; font-weight: 650; }
      @media (max-width: 760px) { .concept-detail { display: none; } }
    </style>
  </body>
</html>
