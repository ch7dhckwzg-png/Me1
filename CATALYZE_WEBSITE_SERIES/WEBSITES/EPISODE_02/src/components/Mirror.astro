---
import site from '../content/site.json';
const { mirror, business } = site;
// The salon's sign, written on a steamed-up salon mirror. On load: the glass
// fogs, the lettering draws itself in fine line, the fog clears from the
// centre, the letters set solid, the rules slide out and the TSS monogram
// drops in. Plays once; nothing follows the scroll or the cursor.
---
<section class="mirror-hero" aria-labelledby="name">
  <div class="wrap mh-in">
    <div class="mirror" data-mirror>
      <div class="glass" aria-hidden="true">
        <i class="r1"></i><i class="r2"></i><i class="r3"></i>
      </div>
      <div class="fog" aria-hidden="true"></div>
      <svg class="letters" viewBox="0 0 520 700" role="img" aria-labelledby="name">
        <title id="name">{business.name}</title>
        <g class="mono" aria-hidden="true">
          <text x="236" y="150">T</text><text x="256" y="172">S</text><text x="276" y="194">S</text>
        </g>
        <line class="rule rule-l" x1="118" x2="196" y1="300" y2="300" />
        <line class="rule rule-r" x1="324" x2="402" y1="300" y2="300" />
        <text class="word w-the" x="260" y="312" text-anchor="middle">THE</text>
        <text class="word w-big" x="260" y="400" text-anchor="middle">SALON</text>
        <text class="word w-big" x="260" y="478" text-anchor="middle">SANCTUARY</text>
      </svg>
      <div class="shine" aria-hidden="true"></div>
    </div>
    <div class="mh-foot">
      <p class="mh-line">{mirror.line}</p>
      <div class="mh-ctas">
        <button type="button" class="btn btn-solid" data-book>{mirror.book}</button>
        <a class="btn" href="#prices">{mirror.prices}</a>
      </div>
      <p class="mh-status data" data-status aria-live="polite"></p>
    </div>
  </div>
</section>

<style>
  @property --clear { syntax: '<percentage>'; inherits: false; initial-value: -30%; }
  .mirror-hero { border-top: 0; padding: clamp(28px, 4vh, 56px) 0 clamp(56px, 8vh, 96px); }
  .mh-in { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .mirror { --h: min(62svh, 640px); position: relative; width: min(calc(var(--h) * .743), 86vw); aspect-ratio: 520 / 700; border-radius: 9999px 9999px 6px 6px; border: 7px solid var(--gold); box-shadow: inset 0 0 0 1px #c9ab73, 0 30px 70px rgba(43, 46, 49, .12); overflow: hidden; isolation: isolate; }
  .glass { position: absolute; inset: 0; background: linear-gradient(172deg, #f3dfe1 0%, #e9cccd 55%, #ddb9b6 100%); }
  .glass i { position: absolute; border-radius: 50%; filter: blur(28px); }
  .glass .r1 { left: 6%; bottom: -6%; width: 34%; height: 46%; background: rgba(231, 198, 191, .9); }
  .glass .r2 { right: 4%; bottom: -2%; width: 26%; height: 52%; background: rgba(19, 21, 23, .16); }
  .glass .r3 { left: 38%; top: 8%; width: 34%; height: 22%; background: rgba(255, 255, 255, .55); }
  .fog { position: absolute; inset: 0; background: rgba(255, 255, 255, .5); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); -webkit-mask: radial-gradient(circle at 50% 50%, transparent var(--clear), #000 calc(var(--clear) + 22%)); mask: radial-gradient(circle at 50% 50%, transparent var(--clear), #000 calc(var(--clear) + 22%)); }
  .letters { position: absolute; inset: 0; width: 100%; height: 100%; }
  .word { font-family: var(--font-display); font-weight: 600; fill: var(--sign); stroke: var(--sign); stroke-width: .9; }
  .w-the { font-size: 34px; letter-spacing: 5px; }
  .w-big { font-size: 66px; letter-spacing: 7px; }
  .rule { stroke: var(--sign); stroke-width: 1.6; }
  .mono text { font-family: var(--font-display); font-size: 30px; fill: var(--sign); }
  .shine { position: absolute; top: 0; bottom: 0; left: -40%; width: 30%; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .4), transparent); transform: skewX(-16deg); opacity: 0; pointer-events: none; }
  .mh-foot { margin-top: clamp(22px, 3.4vh, 36px); display: flex; flex-direction: column; align-items: center; }
  .mh-line { margin: 0 0 20px; font-size: clamp(17px, 1.5vw, 20px); color: var(--fg); }
  .mh-ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .mh-status { margin: 16px 0 0; font-size: 13px; color: var(--muted); display: flex; align-items: center; gap: 10px; min-height: 1.6em; }
  .mh-status :global(.dot) { width: 7px; height: 7px; border-radius: 50%; background: var(--gold); flex: none; }
  .mh-status :global(.dot.open) { background: #4f7a56; }

  /* the sequence (on load, once) */
  :global(.js) .fog { --clear: -30%; opacity: 1; animation: clear 1.5s cubic-bezier(.45, 0, .2, 1) 1.9s forwards; }
  :global(.js) .word { fill-opacity: 0; stroke-dasharray: 3200; stroke-dashoffset: 3200; animation: draw 1.9s cubic-bezier(.45, 0, .25, 1) .35s forwards, solid .9s ease-out 2.5s forwards; }
  :global(.js) .w-big + .w-big { animation-delay: .65s, 2.6s; }
  :global(.js) .rule { transform: scaleX(0); animation: grow .8s var(--ease-out) 2.7s forwards; }
  :global(.js) .rule-l { transform-origin: 196px 300px; }
  :global(.js) .rule-r { transform-origin: 324px 300px; }
  :global(.js) .mono { opacity: 0; transform: translateY(-14px); animation: drop .9s var(--ease-out) 3s forwards; }
  :global(.js) .shine { animation: shine 1.4s cubic-bezier(.45, 0, .25, 1) 3.1s forwards; }
  :global(.js) .mh-foot { opacity: 0; transform: translateY(10px); animation: rise .9s var(--ease-out) .5s forwards; }
  @keyframes clear { 70% { opacity: 1; } to { --clear: 110%; opacity: 0; } }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes solid { to { fill-opacity: 1; stroke-width: 0; } }
  @keyframes grow { to { transform: scaleX(1); } }
  @keyframes drop { to { opacity: 1; transform: none; } }
  @keyframes shine { 0% { opacity: 1; } to { opacity: 1; transform: skewX(-16deg) translateX(560%); } }
  @keyframes rise { to { opacity: 1; transform: none; } }
  @media (max-width: 600px) {
    .mirror { --h: min(56svh, 520px); border-width: 5px; }
  }
</style>
