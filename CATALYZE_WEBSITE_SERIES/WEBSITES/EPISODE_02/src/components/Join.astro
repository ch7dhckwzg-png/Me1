---
import site from '../content/site.json';
const { join, sites, concept } = site;
---
<section id="join" class="join">
  <div class="wrap grid">
    <div class="reveal">
      <h2 class="h-section">{join.headline}</h2>
      <p class="lead">{join.body}</p>
    </div>
    <form class="reveal" data-join novalidate>
      <div class="field">
        <label for="j-name">Name</label>
        <input id="j-name" name="name" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="j-email">Email</label>
        <input id="j-email" name="email" type="email" autocomplete="email" required />
      </div>
      <fieldset class="field">
        <legend>Your gym</legend>
        <div class="chips">
          {Object.values(sites).map((s) => <label class="chip"><input type="radio" name="gym" value={s.id} data-gym-radio={s.id} /><span>{s.name}</span></label>)}
        </div>
      </fieldset>
      <fieldset class="field">
        <legend>What you're after</legend>
        <div class="chips">
          {join.goals.map((g) => <label class="chip"><input type="radio" name="goal" value={g} /><span>{g}</span></label>)}
        </div>
      </fieldset>
      <button class="btn btn-solid" type="submit">Send</button>
      <p class="msg" data-msg role="status" aria-live="polite"></p>
      <p class="note">{join.demoNotice}</p>
    </form>
  </div>
</section>

<footer class="foot">
  <div class="wrap foot-in">
    <span class="fmark display">APEX</span>
    <p><b>{concept.label}.</b> {concept.detail} The mark and colours are placeholders, not Apex's branding. Website concept and build by CATALYZE, {concept.catalyze}.</p>
  </div>
</footer>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(40px, 7vw, 120px); align-items: start; }
  form { display: grid; gap: 22px; }
  .field { display: grid; gap: 8px; border: 0; margin: 0; padding: 0; min-width: 0; }
  label, legend { font: 650 12px/1 var(--font-body); letter-spacing: .14em; text-transform: uppercase; color: var(--muted); padding: 0; }
  input:not([type="radio"]) { font: 400 18px/1.3 var(--font-body); color: var(--fg); background: transparent; border: 0; border-bottom: 1px solid var(--line); padding: 10px 0; border-radius: 0; transition: border-color .3s; }
  input:not([type="radio"]):focus { outline: none; border-color: var(--accent); }
  input[aria-invalid="true"] { border-color: var(--accent); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
  .chip { position: relative; letter-spacing: 0; text-transform: none; }
  .chip input { position: absolute; opacity: 0; pointer-events: none; }
  .chip span { display: inline-block; border: 1px solid var(--line); border-radius: var(--radius); padding: 11px 14px; font: 600 15px/1 var(--font-body); color: var(--fg); cursor: pointer; transition: background-color .25s, color .25s, border-color .25s; }
  .chip input:checked + span { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .chip input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 3px; }
  button[type="submit"] { justify-self: start; }
  .msg { margin: 0; min-height: 1.4em; font-weight: 600; }
  .msg.ok { color: var(--fg); }
  .msg.err { color: var(--accent); }
  .foot { background: #0b0c0d; color: #efede8; padding-block: 48px calc(48px + env(safe-area-inset-bottom, 0px)); }
  .foot-in { display: flex; flex-wrap: wrap; gap: 16px 48px; align-items: baseline; justify-content: space-between; }
  .fmark { font-size: 40px; }
  .foot p { max-width: 58ch; margin: 0; font-size: 13px; color: #9a9ca1; }
  .foot b { color: #efede8; font-weight: 600; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
</style>
