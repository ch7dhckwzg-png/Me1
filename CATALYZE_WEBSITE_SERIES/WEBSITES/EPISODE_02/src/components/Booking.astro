---
import site from '../content/site.json';
const { booking, business } = site;
---
<div class="mbar" data-mbar>
  <p class="mbar-status data" data-status-short></p>
  <button type="button" class="btn btn-solid" data-book>Book an appointment</button>
</div>
<dialog class="sheet" data-sheet aria-labelledby="sheet-title">
  <div class="sheet-in">
    <div class="sheet-top">
      <button type="button" class="icon-btn" data-sheet-back aria-label="Back" hidden>
        <svg viewBox="0 0 20 20"><path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
      </button>
      <p id="sheet-title" class="sheet-title">Book an appointment</p>
      <button type="button" class="icon-btn" data-sheet-close aria-label="Close">
        <svg viewBox="0 0 20 20"><path d="M5 5l10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
      </button>
    </div>
    <ol class="steps" aria-label="Booking steps">
      <li data-step="1"><span class="data">1</span> Service</li>
      <li data-step="2"><span class="data">2</span> Check</li>
      <li data-step="3"><span class="data">3</span> Time</li>
    </ol>
    <div class="sheet-body" data-sheet-body tabindex="-1"></div>
    <div class="sheet-foot" data-sheet-foot hidden>
      <a class="btn btn-solid go" data-go href={booking.base} target="_blank" rel="noopener">
        Choose a time
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
      </a>
      <p class="handoff">{booking.handoff}</p>
    </div>
  </div>
</dialog>
<script type="application/json" id="booking-data" set:html={JSON.stringify(booking)} />

<style>
  .mbar { display: none; }
  @media (max-width: 860px) {
    .mbar { display: flex; align-items: center; gap: 14px; position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; padding: 12px var(--gutter-r) calc(12px + env(safe-area-inset-bottom, 0px)) var(--gutter-l); background: color-mix(in srgb, var(--bg) 90%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-top: 1px solid var(--line); transition: transform .4s var(--ease-out); }
    .mbar .btn { margin-left: auto; padding: 14px 18px; white-space: nowrap; flex: none; }
    .mbar-status { margin: 0; font-size: 12px; color: var(--muted); line-height: 1.35; }
    :global(.mbar-away) .mbar { transform: translateY(110%); }
  }

  .sheet { position: fixed; inset: 0 0 0 auto; margin: 0; width: min(500px, 100vw); max-width: 100vw; height: 100dvh; max-height: 100dvh; padding: 0; border: 0; background: var(--bg); color: var(--fg); box-shadow: -30px 0 60px rgba(19, 21, 23, .16); transform: translateX(100%); transition: transform .5s var(--ease-out), overlay .5s allow-discrete, display .5s allow-discrete; }
  .sheet[open] { transform: none; }
  @starting-style { .sheet[open] { transform: translateX(100%); } }
  .sheet::backdrop { background: rgba(19, 21, 23, 0); transition: background-color .4s, overlay .4s allow-discrete, display .4s allow-discrete; }
  .sheet[open]::backdrop { background: rgba(19, 21, 23, .42); }
  @starting-style { .sheet[open]::backdrop { background: rgba(19, 21, 23, 0); } }
  .sheet-in { display: flex; flex-direction: column; height: 100%; }
  .sheet-top { display: flex; align-items: center; gap: 12px; padding: 18px 20px 12px; }
  .sheet-title { margin: 0 auto 0 0; font-family: var(--font-display); font-size: 22px; font-weight: 600; line-height: 1.2; }
  [data-sheet-back]:not([hidden]) + .sheet-title { margin-left: 0; }
  .icon-btn { width: 40px; height: 40px; flex: none; border-radius: 50%; border: 1px solid var(--line); background: transparent; color: var(--fg); display: grid; place-items: center; cursor: pointer; -webkit-tap-highlight-color: transparent; transition: background-color .2s, transform .16s var(--ease-out); }
  .icon-btn:active { transform: scale(.94); }
  @media (hover: hover) { .icon-btn:hover { background: var(--bg-2); } }
  .icon-btn svg { width: 18px; height: 18px; }
  .steps { list-style: none; display: flex; gap: 6px; margin: 0; padding: 4px 20px 16px; border-bottom: 1px solid var(--line); }
  .steps li { flex: 1; font-size: 13px; color: var(--muted); padding-top: 10px; border-top: 2px solid var(--line); transition: border-color .3s, color .3s; }
  .steps li span { margin-right: 4px; }
  .steps li.on { color: var(--fg); border-top-color: var(--rose); }
  .sheet-body { flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: 22px 20px 28px; outline: none; }
  .sheet-foot { padding: 16px 20px calc(18px + env(safe-area-inset-bottom, 0px)); border-top: 1px solid var(--line); background: var(--bg); }
  .go { width: 100%; padding: 18px 20px; font-size: 16px; }
  .handoff { margin: 12px 0 0; font-size: 13px; line-height: 1.5; color: var(--muted); }
  @media (max-width: 600px) {
    .sheet { inset: auto 0 0 0; width: 100vw; height: 92dvh; border-radius: 14px 14px 0 0; transform: translateY(100%); box-shadow: 0 -20px 50px rgba(19, 21, 23, .18); }
    .sheet[open] { transform: none; }
    @starting-style { .sheet[open] { transform: translateY(100%); } }
  }

  /* views, rendered by main.ts */
  .sheet-body :global(.v-lead) { margin: 0 0 16px; font-size: 15px; color: var(--muted); }
  .sheet-body :global(.opt) { width: 100%; display: grid; grid-template-columns: 1fr auto 18px; gap: 4px 14px; align-items: center; padding: 16px 12px; margin: 0 -12px; border: 0; border-bottom: 1px solid var(--line); background: none; text-align: left; font: inherit; color: var(--fg); cursor: pointer; border-radius: var(--radius); -webkit-tap-highlight-color: transparent; transition: background-color .2s; width: calc(100% + 24px); }
  .sheet-body :global(.opt:active) { background: var(--bg-2); }
  @media (hover: hover) { .sheet-body :global(.opt:hover) { background: var(--bg-2); } }
  .sheet-body :global(.opt-name) { font-size: 17px; line-height: 1.3; }
  .sheet-body :global(.opt-sub) { grid-column: 1; font-size: 14px; color: var(--muted); }
  .sheet-body :global(.opt-price) { grid-row: 1; grid-column: 2; font-size: 14px; }
  .sheet-body :global(.opt-price small) { font-size: 12px; color: var(--muted); }
  .sheet-body :global(.opt svg) { grid-row: 1 / span 2; grid-column: 3; width: 16px; height: 16px; color: var(--muted); }
  .sheet-body :global(.cat-title) { margin: 0 0 6px; font-family: var(--font-display); font-size: 30px; font-weight: 600; line-height: 1.1; }
  .sheet-body :global(.note) { margin: 0 0 18px; font-size: 14px; color: var(--muted); padding-left: 12px; border-left: 2px solid var(--tile); }
  .sheet-body :global(.pick) { padding: 22px 0 20px; border-bottom: 1px solid var(--line); }
  .sheet-body :global(.pick-cat) { margin: 0 0 8px; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); font-weight: 500; }
  .sheet-body :global(.pick-name) { margin: 0; font-family: var(--font-display); font-size: 34px; line-height: 1.05; font-weight: 600; text-wrap: balance; }
  .sheet-body :global(.pick-meta) { display: flex; gap: 22px; margin: 16px 0 0; font-size: 15px; }
  .sheet-body :global(.pick-meta span) { color: var(--muted); }
  .sheet-body :global(.pick-meta b) { color: var(--fg); font-weight: 400; }
  .sheet-body :global(.before) { margin: 24px 0 0; }
  .sheet-body :global(.before h3) { margin: 0 0 10px; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); font-weight: 500; }
  .sheet-body :global(.before ul) { list-style: none; margin: 0; padding: 0; }
  .sheet-body :global(.before li) { display: grid; grid-template-columns: 18px 1fr; gap: 12px; padding: 10px 0; font-size: 15px; line-height: 1.5; border-bottom: 1px solid var(--line); }
  .sheet-body :global(.before li svg) { width: 18px; height: 18px; margin-top: 2px; color: var(--rose); }
  .sheet-body :global(.swap) { margin-top: 20px; width: 100%; justify-content: space-between; text-align: left; }
  .sheet-body :global(.swap small) { display: block; color: var(--muted); font-size: 13px; margin-top: 4px; font-weight: 400; }
</style>
