---
import site from '../content/site.json';
const { prices, menu } = site;
const money = (n: number) => (Number.isInteger(n) ? `£${n}` : `£${n.toFixed(2)}`);
const dur = (m?: number | null) => (!m ? '' : m < 60 ? `${m} min` : `${Math.floor(m / 60)} hr${m % 60 ? ` ${m % 60} min` : ''}`);
const low = (c: any) => Math.min(...c.items.map((i: any) => i.price));
---
<section id="prices" class="prices" aria-labelledby="prices-title">
  <div class="wrap">
    <div class="head reveal">
      <h2 id="prices-title" class="h-section">{prices.title}</h2>
      <p class="lead">{prices.lead}</p>
    </div>

    <div class="tabs reveal" role="tablist" aria-label="Service categories">
      {menu.map((c, i) => (
        <button type="button" role="tab" id={`tab-${c.key}`} aria-controls={`panel-${c.key}`} aria-selected={i === 1 ? 'true' : 'false'} tabindex={i === 1 ? 0 : -1} data-tab={c.key}>
          {c.label}
        </button>
      ))}
    </div>

    {menu.map((c, i) => (
      <div class="panel" role="tabpanel" id={`panel-${c.key}`} aria-labelledby={`tab-${c.key}`} hidden={i !== 1} data-panel={c.key}>
        <div class="panel-head">
          <p class="panel-blurb">{c.blurb}</p>
          <p class="panel-from data">{prices.from} {money(low(c))}</p>
        </div>
        {c.note && <p class="panel-note">{c.note}</p>}
        <ul class="rows">
          {c.items.map((it: any) => (
            <li>
              <button type="button" class="row" data-book-id={it.id}>
                <span class="row-name">{it.name}{it.note && <span class="row-note">{it.note}</span>}</span>
                <span class="row-dur data">{dur(it.mins)}</span>
                <span class="row-price data">{it.from && <small>{prices.from} </small>}{money(it.price)}</span>
                <span class="row-go" aria-hidden="true">
                  <svg viewBox="0 0 16 16"><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
                </span>
                <span class="sr-only">Book {it.name}</span>
              </button>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .head { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 64px; align-items: end; margin-bottom: 48px; }
  .head .h-section { margin: 0; }
  .tabs { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; padding-bottom: 2px; border-bottom: 1px solid var(--line); margin-bottom: 32px; overscroll-behavior-x: contain; }
  .tabs::-webkit-scrollbar { display: none; }
  .tabs button { flex: none; border: 0; background: none; padding: 14px 14px 16px; font: 500 15px/1 var(--font-body); color: var(--muted); cursor: pointer; position: relative; -webkit-tap-highlight-color: transparent; transition: color .2s; }
  .tabs button::after { content: ""; position: absolute; left: 14px; right: 14px; bottom: -3px; height: 2px; background: var(--rose); transform: scaleX(0); transition: transform .3s var(--ease-out); }
  .tabs button[aria-selected="true"] { color: var(--fg); }
  .tabs button[aria-selected="true"]::after { transform: scaleX(1); }
  @media (hover: hover) { .tabs button:hover { color: var(--fg); } }
  .panel-head { display: flex; justify-content: space-between; gap: 24px; align-items: baseline; }
  .panel-blurb { margin: 0; font-family: var(--font-display); font-size: clamp(24px, 2.4vw, 32px); font-weight: 500; line-height: 1.15; }
  .panel-from { margin: 0; color: var(--muted); font-size: 14px; white-space: nowrap; }
  .panel-note { margin: 12px 0 0; max-width: 70ch; font-size: 15px; color: var(--muted); padding-left: 14px; border-left: 2px solid var(--tile); }
  .rows { list-style: none; margin: 26px 0 0; padding: 0; border-top: 1px solid var(--line); }
  .rows li { border-bottom: 1px solid var(--line); }
  .row { width: 100%; display: grid; grid-template-columns: minmax(0, 1fr) 110px 110px 28px; gap: 16px; align-items: center; padding: 17px 6px; border: 0; background: none; text-align: left; color: var(--fg); font: inherit; cursor: pointer; border-radius: var(--radius); -webkit-tap-highlight-color: transparent; transition: background-color .2s; }
  .row:active { background: var(--bg-2); }
  @media (hover: hover) { .row:hover { background: var(--bg-2); } .row:hover .row-go { color: var(--rose); transform: translateX(3px); } }
  .row-name { font-size: 17px; line-height: 1.35; }
  .row-note { display: block; font-size: 14px; color: var(--muted); margin-top: 2px; }
  .row-dur { font-size: 13px; color: var(--muted); }
  .row-price { font-size: 15px; text-align: right; }
  .row-price small { font-size: 12px; color: var(--muted); }
  .row-go { color: var(--muted); display: flex; justify-content: flex-end; transition: color .2s, transform .2s var(--ease-out); }
  .row-go svg { width: 16px; height: 16px; }
  :global(.sr-only) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  :global(html:not(.js)) .panel[hidden] { display: block; }
  @media (max-width: 760px) {
    .head { grid-template-columns: 1fr; margin-bottom: 32px; }
    .tabs { margin-left: calc(-1 * var(--gutter-l)); margin-right: calc(-1 * var(--gutter-r)); padding-left: calc(var(--gutter-l) - 14px); }
    .row { grid-template-columns: minmax(0, 1fr) auto 20px; gap: 6px 12px; padding: 15px 2px; }
    .row-dur { grid-column: 1; grid-row: 2; }
    .row-price { grid-column: 2; grid-row: 1; }
    .row-go { grid-column: 3; grid-row: 1; }
    .panel-head { flex-direction: column; gap: 6px; }
  }
</style>
