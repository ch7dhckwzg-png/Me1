---
import site from '../content/site.json';
const { hero } = site;
// Their herringbone wall (from the photo behind the basins) is painted on a
// canvas tile by tile when the section arrives (main.ts), then a black basin
// settles in front of it.
const W = 600, H = 640;
---
<section class="intro" id="start" aria-labelledby="hero-title">
  <div class="wrap hero-in">
    <div class="copy">
      <h2 id="hero-title" class="title reveal">
        {hero.title.map((l) => <span class="line">{l}</span>)}
      </h2>
      <p class="lead hero-lead">{hero.lead}</p>
      <div class="quick" role="group" aria-labelledby="quick-label">
        <p id="quick-label" class="quick-label">{hero.quick}</p>
        <div class="quick-row">
          {hero.quickPicks.map((q) => (
            <button type="button" class="btn quick-btn" data-book-cat={q.key}>{q.label}</button>
          ))}
        </div>
      </div>
      <p class="status data" data-status aria-live="polite"></p>
    </div>
    <div class="wall reveal-wall" aria-hidden="true">
      <canvas data-wall></canvas>
      <svg class="basin-art" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice">
        <g class="basin">
          <ellipse cx="300" cy="640" rx="230" ry="22" fill="#000" opacity=".12" />
          <path d="M 140 640 L 140 548 Q 140 506 182 504 L 418 504 Q 460 506 460 548 L 460 640 Z" fill="#17191c" />
          <path d="M 154 640 L 154 552 Q 154 520 186 518 L 414 518 Q 446 520 446 552 L 446 640" fill="none" stroke="#a9874f" stroke-width="1.6" opacity=".85" />
          {[205, 255, 300, 345, 395].map((x) => <line x1={x} x2={x} y1="528" y2="640" stroke="#2c3035" stroke-width="2" />)}
          <path d="M 176 510 Q 300 498 424 510" stroke="#fff" stroke-opacity=".12" stroke-width="2" fill="none" />
          <g transform="translate(300 430)">
            <path d="M 20 70 L 14 92 L -14 92 L -20 70" fill="#0e0f11" />
            <path d="M -138 0 Q -130 80 0 86 Q 130 80 138 0 Z" fill="#111215" />
            <ellipse rx="138" ry="24" fill="#2a2e33" />
            <ellipse rx="121" ry="16" cy="2" fill="#07080a" />
            <path d="M -104 -11 Q -28 -24 48 -20" stroke="#fff" stroke-opacity=".32" stroke-width="3" fill="none" />
            <path d="M -120 22 Q -60 60 10 64" stroke="#fff" stroke-opacity=".08" stroke-width="10" fill="none" />
          </g>
        </g>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero-in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px 72px; align-items: center; }
  .title { font-family: var(--font-display); font-weight: 500; font-size: clamp(42px, 4.6vw, 70px); line-height: 1; letter-spacing: -0.02em; margin: 0 0 26px; }
  .title .line { display: block; }
  .title .line:last-child { color: var(--rose); }
  .hero-lead { margin-bottom: 34px; }
  .quick-label { margin: 0 0 12px; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; font-weight: 500; color: var(--muted); }
  .quick-row { display: flex; flex-wrap: wrap; gap: 8px; max-width: 560px; }
  .quick-btn { padding: 12px 16px; font-size: 15px; background: color-mix(in srgb, #fff 45%, transparent); }
  @media (hover: hover) { .quick-btn:hover { background: var(--sign); color: var(--fascia); border-color: var(--sign); } }
  .status { margin: 22px 0 0; font-size: 13px; color: var(--muted); display: flex; align-items: center; gap: 10px; min-height: 1.6em; }
  .status :global(.dot) { width: 7px; height: 7px; border-radius: 50%; background: var(--gold); flex: none; }
  .status :global(.dot.open) { background: #4f7a56; }
  .wall { position: relative; aspect-ratio: 600 / 640; border-radius: var(--radius); overflow: hidden; box-shadow: 0 30px 60px rgba(43, 46, 49, .12); background: #efe1df; }
  .wall canvas, .wall svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  :global(.js) .reveal-wall .basin { opacity: 0; transform: translateY(40px); transition: opacity .7s ease-out 1.6s, transform 1s var(--ease-out) 1.6s; }
  :global(.js) .reveal-wall.in .basin { opacity: 1; transform: none; }
  @media (max-width: 900px) { .hero-in { grid-template-columns: 1fr; } .title { font-size: clamp(38px, 10vw, 56px); } .wall { max-width: 460px; width: 100%; } }
</style>
