---
import site from '../content/site.json';
const { room } = site;
const icons: Record<string, string> = {
  access: '<circle cx="12" cy="4.5" r="1.8"/><path d="M12 7.5v6h5l2 5"/><path d="M8.5 10.5a5.5 5.5 0 1 0 7.6 7"/>',
  park: '<rect x="4" y="3.5" width="16" height="17" rx="2"/><path d="M10 16.5v-9h3a3 3 0 0 1 0 6h-3"/>',
  card: '<rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3 10h18M7 15h4"/>',
  woman: '<circle cx="12" cy="9" r="5"/><path d="M12 14v7M9 18h6"/>',
  bus: '<rect x="5" y="3.5" width="14" height="14" rx="2"/><path d="M5 11h14M8 17.5V20M16 17.5V20"/><circle cx="8.5" cy="14.3" r=".6"/><circle cx="15.5" cy="14.3" r=".6"/>',
  heart: '<path d="M12 19.5s-7-4.3-7-9.3A3.8 3.8 0 0 1 12 8a3.8 3.8 0 0 1 7 2.2c0 5-7 9.3-7 9.3Z"/>',
};
---
<section class="room" aria-labelledby="room-title">
  <div class="wrap">
    <h2 id="room-title" class="h-section reveal">{room.title}</h2>
    <ul class="facts">
      {room.facts.map((f) => (
        <li class="reveal">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={icons[f.icon]} />
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .room .h-section { max-width: 14ch; margin-bottom: 56px; }
  .facts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .facts li { padding: 30px 28px 34px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .facts svg { width: 26px; height: 26px; color: var(--rose); }
  .facts h3 { margin: 18px 0 6px; font-family: var(--font-display); font-size: 26px; font-weight: 600; line-height: 1.15; }
  .facts p { margin: 0; color: var(--muted); font-size: 16px; }
  @media (max-width: 860px) { .facts { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 540px) { .facts { grid-template-columns: 1fr; } .facts li { padding: 24px 20px 26px; } }
</style>
