---
import site from '../content/site.json';
const { sites, business } = site;
const slides = [sites.birkenhead, sites.ellesmere];
---
<section class="hero-track" id="top" data-hero-track>
  <div class="hero">
    <div class="plate-stage" data-plate-stage aria-hidden="true">
      <div class="plate-shadow"></div>
      <div class="rotor" data-rotor>
        <canvas class="plate" data-plate="birkenhead"></canvas>
        <canvas class="plate" data-plate="ellesmere"></canvas>
      </div>
    </div>

    <div class="wrap inner">
      <div class="meta">
        <span class="label">{business.type} · Birkenhead · Ellesmere Port</span>
        <span class="label hint" data-hint>Scroll for Ellesmere Port</span>
      </div>
      <div class="copies">
        <h1 class="sr">Apex: gyms in Birkenhead and Ellesmere Port</h1>
        {slides.map((s, n) => (
          <div class={`copy s-${s.id}`} data-copy={s.id} aria-hidden={n ? 'true' : 'false'}>
            <p class="label kick"><span class="data">0{n + 1}</span><span class="bar"></span>{s.area}</p>
            <p class="title display" aria-hidden="true">{s.headline.map((l, i) => <span class="line"><span style={`--d:${i * 80}ms`}>{l}</span></span>)}</p>
            <p class="lead body">{s.body}</p>
            <div class="ctas">
              <a class="btn btn-solid" href="#timetable">See the timetable
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              <a class="btn" href="#join">Join</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero-track { position: relative; height: calc(100svh + 90vh); border-top: 0; padding: 0; }
  .hero { position: sticky; top: 72px; height: calc(100svh - 72px); min-height: 620px; overflow: hidden; display: flex; }
  .inner { position: relative; z-index: 2; display: flex; flex-direction: column; width: 100%; padding-block: clamp(18px, 2.4vw, 32px); }
  .meta { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .hint { transition: opacity .6s; }
  :global([data-site="ellesmere"]) .hint { opacity: 0; }

  .plate-stage { position: absolute; z-index: 1; left: 0; top: 47%; width: min(44vw, 640px, 70svh); aspect-ratio: 1; margin-top: calc(min(44vw, 640px, 70svh) / -2); pointer-events: none; will-change: transform; }
  .plate-shadow { position: absolute; inset: 10% 8% 2% 10%; border-radius: 50%; background: rgba(20, 16, 12, .32); filter: blur(30px); transform: translateY(6%); transition: background-color 1.2s var(--ease); }
  :global([data-site="ellesmere"]) .plate-shadow { background: rgba(0, 0, 0, .7); }
  .rotor { position: absolute; inset: 0; }
  .plate { position: absolute; inset: 0; width: 100%; height: 100%; }
  .plate[data-plate="ellesmere"] { opacity: 0; }
  :global(.intro) .plate-stage .rotor { transform: translateX(-60%) rotate(-140deg); }
  .rotor { transition: transform 1.6s cubic-bezier(.2,.8,.2,1); }

  .copies { flex: 1; display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 48px; }
  .copy { grid-row: 1; max-width: 580px; }
  .s-birkenhead { grid-column: 2; justify-self: end; }
  .s-ellesmere { grid-column: 1; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .kick { color: var(--accent); display: flex; align-items: center; }
  .kick .data { color: var(--muted); }
  .bar { display: inline-block; width: 28px; height: 1px; background: currentColor; margin: 0 12px; opacity: .6; }
  .title { font-size: clamp(56px, 7.6vw, 128px); margin: 18px 0 22px; display: flex; flex-direction: column; white-space: nowrap; }
  .line { display: block; overflow: hidden; padding-bottom: .04em; }
  .line > span { display: block; transition: transform 1s cubic-bezier(.7,0,.2,1); transition-delay: var(--d); }
  .line:last-child > span { color: var(--accent); }
  .kick, .body, .ctas { transition: opacity .7s var(--ease), transform .8s var(--ease); }
  .lead { max-width: 40ch; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }

  .s-ellesmere .line > span { transform: translateY(105%); }
  .s-ellesmere :is(.kick, .body, .ctas) { opacity: 0; transform: translateY(12px); pointer-events: none; }
  :global([data-site="ellesmere"]) .s-birkenhead .line > span { transform: translateY(-105%); }
  :global([data-site="ellesmere"]) .s-birkenhead :is(.kick, .body, .ctas) { opacity: 0; transform: translateY(-12px); pointer-events: none; }
  :global([data-site="ellesmere"]) .s-ellesmere .line > span { transform: none; transition-delay: calc(300ms + var(--d)); }
  :global([data-site="ellesmere"]) .s-ellesmere :is(.kick, .body, .ctas) { opacity: 1; transform: none; pointer-events: auto; transition-delay: .4s; }
  :global(.intro) .s-birkenhead .line > span { transform: translateY(105%); }
  :global(.intro) .s-birkenhead :is(.kick, .body, .ctas) { opacity: 0; }

  @media (max-width: 900px) {
    .hero-track { height: calc(100svh + 60vh); }
    .hero { min-height: 0; }
    .plate-stage { top: 70px; width: 62vw; margin-top: 0; }
    .copies { grid-template-columns: 1fr; align-items: end; padding-bottom: 8px; }
    .copy, .s-birkenhead, .s-ellesmere { grid-column: 1; justify-self: start; }
    .hint { display: none; }
    .title { font-size: clamp(48px, 13vw, 80px); }
  }
  @media (prefers-reduced-motion: reduce) { .hero-track { height: auto; } .hero { position: relative; top: 0; height: auto; min-height: 640px; } }
</style>
