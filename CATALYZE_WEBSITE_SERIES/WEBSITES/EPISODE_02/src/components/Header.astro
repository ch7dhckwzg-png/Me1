---
import site from '../content/site.json';
const { nav, sites } = site;
---
<header class="hdr">
  <div class="wrap hdr-in">
    <a href="#top" class="mark" aria-label="Apex, back to top">
      <svg viewBox="0 0 32 24" aria-hidden="true"><path d="M1 23 16 1l15 22h-6.5L16 10.6 7.5 23Z" fill="currentColor"/><path d="M12.8 23 16 18.2 19.2 23Z" fill="var(--accent)"/></svg>
      <span>APEX</span>
    </a>
    <nav aria-label="Sections"><ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul></nav>
    <div class="switch" role="group" aria-label="Choose your gym">
      {Object.values(sites).map((s) => <button type="button" data-set-site={s.id} aria-pressed="false">{s.name}</button>)}
    </div>
  </div>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--bg) 84%, transparent); backdrop-filter: blur(14px) saturate(1.2); -webkit-backdrop-filter: blur(14px) saturate(1.2); border-bottom: 1px solid var(--line); padding-top: env(safe-area-inset-top, 0px); }
  .hdr-in { display: flex; align-items: center; gap: 32px; height: 72px; }
  .mark { display: flex; align-items: center; gap: 10px; text-decoration: none; font-family: var(--font-display); font-weight: 850; font-variation-settings: "wdth" 70; font-size: 28px; letter-spacing: .02em; }
  .mark svg { width: 30px; height: 23px; }
  nav { margin-left: auto; }
  nav ul { display: flex; gap: 30px; list-style: none; margin: 0; padding: 0; }
  nav a { text-decoration: none; font-size: 13px; font-weight: 650; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); transition: color .25s; }
  nav a:hover { color: var(--fg); }
  .switch { display: flex; border: 1px solid var(--line); border-radius: var(--radius); padding: 3px; gap: 2px; }
  .switch button { border: 0; background: none; padding: 8px 12px; border-radius: 4px; font: 650 12px/1 var(--font-body); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); cursor: pointer; transition: background-color .3s, color .3s; white-space: nowrap; }
  .switch button[aria-pressed="true"] { background: var(--fg); color: var(--bg); }
  @media (max-width: 900px) { nav { display: none; } .switch { margin-left: auto; } }
  @media (max-width: 420px) { .mark span { display: none; } .switch button { padding: 8px 9px; letter-spacing: .06em; } }
</style>
