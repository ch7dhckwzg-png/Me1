---
import site from '../content/site.json';
const { sites, gyms } = site;
---
<section id="gyms">
  <div class="wrap">
    <h2 class="h-section reveal">{gyms.headline}</h2>
    <div class="grid">
      {Object.values(sites).map((s) => (
        <article class="gym reveal" data-gym={s.id}>
          <p class="label">{s.area}</p>
          <h3 class="display">{s.name}</h3>
          <address>{s.address.lines.map((l) => <span>{l}</span>)}</address>
          <p class="hours data">{s.hours.text}</p>
          <div class="ctas">
            <button type="button" class="btn mine" data-set-site={s.id}>
              <span class="when-off">Make this my gym</span><span class="when-on">Your gym</span>
            </button>
            <a class="btn" href={s.mapsUrl} target="_blank" rel="noopener">Directions</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 16px; }
  .gym { border-top: 3px solid var(--line); padding: 26px 0 0; display: flex; flex-direction: column; gap: 14px; transition: border-color .4s; }
  :global([data-site="birkenhead"]) .gym[data-gym="birkenhead"], :global([data-site="ellesmere"]) .gym[data-gym="ellesmere"] { border-color: var(--accent); }
  h3 { margin: 0; font-size: clamp(48px, 6vw, 92px); }
  address { font-style: normal; display: flex; flex-direction: column; color: var(--muted); font-size: 18px; }
  .hours { margin: 0; color: var(--muted); font-size: 14px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  .when-on { display: none; }
  .mine[aria-pressed="true"] { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .mine[aria-pressed="true"] .when-on { display: inline; }
  .mine[aria-pressed="true"] .when-off { display: none; }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr; gap: 48px; } }
</style>
