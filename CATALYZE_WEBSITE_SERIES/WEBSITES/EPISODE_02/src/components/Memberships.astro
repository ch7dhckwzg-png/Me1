---
import site from '../content/site.json';
const { memberships } = site;
---
<section id="memberships">
  <div class="wrap">
    <h2 class="h-section reveal">{memberships.headline}</h2>
    <div class="plans">
      {memberships.plans.map((p, i) => (
        <article class={`plan reveal ${p.featured ? 'featured' : ''}`} style={`--i:${i}`}>
          <h3>{p.name}</h3>
          <p class="price">{p.price}</p>
          <ul>{p.points.map((pt) => <li>{pt}</li>)}</ul>
          <a class={`btn ${p.featured ? 'btn-solid' : ''}`} href="#join">Ask about {p.name.toLowerCase()}</a>
        </article>
      ))}
    </div>
    <p class="note">{memberships.note}</p>
  </div>
</section>

<style>
  section { background: var(--bg-2); }
  .plans { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 16px; }
  .plan { border: 1px solid var(--line); border-radius: 12px; padding: 30px 28px; display: flex; flex-direction: column; gap: 16px; background: var(--bg); transition-delay: calc(var(--i) * 80ms); }
  .plan.featured { border-color: var(--accent); }
  h3 { margin: 0; font-family: var(--font-display); font-weight: 800; font-variation-settings: "wdth" 78; text-transform: uppercase; font-size: 34px; line-height: 1; }
  .price { margin: 0; font-family: var(--font-mono); font-size: 15px; color: var(--muted); letter-spacing: .04em; }
  ul { list-style: none; margin: 0; padding: 14px 0 0; border-top: 1px solid var(--line); flex: 1; color: var(--muted); font-size: 15px; }
  .btn { align-self: flex-start; }
  @media (max-width: 860px) { .plans { grid-template-columns: 1fr; } }
</style>
